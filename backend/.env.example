# Copy to .env for local development. Every value here is a safe placeholder.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://cadence@127.0.0.1:54329/cadence_dev
TEST_DATABASE_URL=postgresql+asyncpg://cadence@127.0.0.1:54329/cadence_test
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
# Email: leave RESEND_API_KEY empty to log links to the console in development.
RESEND_API_KEY=
EMAIL_FROM=Cadence <no-reply@cadence.local>
# Google sign-in: leave empty to disable (the endpoints answer OAUTH_NOT_CONFIGURED).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENTRY_DSN=
EXPORT_DIR=./var/exports
