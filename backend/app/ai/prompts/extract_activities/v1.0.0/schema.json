{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "entry_summary": {
      "type": "string",
      "maxLength": 120,
      "description": "One line, at most 120 characters"
    },
    "activities": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "properties": {
          "temp_id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_quote": {
            "type": "string",
            "description": "Verbatim substring of the journal entry"
          },
          "category_id": {
            "type": "string",
            "description": "id from the supplied category list"
          },
          "time_ref": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "range",
                  "duration",
                  "point",
                  "vague",
                  "none"
                ]
              },
              "start": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "hour": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 23
                  },
                  "minute": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 59
                  },
                  "meridiem": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "am",
                      "pm",
                      null
                    ]
                  }
                },
                "required": [
                  "hour"
                ]
              },
              "end": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "hour": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 23
                  },
                  "minute": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 59
                  },
                  "meridiem": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "am",
                      "pm",
                      null
                    ]
                  }
                },
                "required": [
                  "hour"
                ]
              },
              "start_anchor": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "previous_end",
                  null
                ]
              },
              "end_anchor": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "next_start",
                  null
                ]
              },
              "duration_minutes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 1440
              },
              "approximate": {
                "type": "boolean"
              },
              "window": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "label": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "morning",
                      "afternoon",
                      "evening",
                      "night",
                      null
                    ]
                  }
                }
              },
              "day_offset": {
                "type": "integer",
                "minimum": -7,
                "maximum": 7
              },
              "quote": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The words that carry the time"
              }
            },
            "required": [
              "kind"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tag_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "new": {
                  "type": "boolean"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "task": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "task_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "new_task_title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "location_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "office",
              "home",
              "remote",
              "travel",
              "other",
              null
            ]
          },
          "confidence": {
            "type": "object",
            "properties": {
              "overall": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "time": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "category": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "overall",
              "time",
              "category"
            ]
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "temp_id",
          "order",
          "title",
          "source_quote",
          "category_id",
          "time_ref",
          "confidence"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "entry_summary",
    "activities"
  ]
}
